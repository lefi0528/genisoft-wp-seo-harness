{
  "name": "genisoft-wp-seo-harness",
  "version": "1.0.0",
  "description": "Autonomous WordPress Technical SEO Engineering Harness for AI Coding Agents",
  "main": "tools/schema-graph-validator.js",
  "scripts": {
    "dev": "vitepress dev docs",
    "build": "vitepress build docs",
    "preview": "vitepress preview docs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "node tools/schema-graph-validator.js --test && node tests/schema-validator.test.js",
    "test:php": "php tools/verify-seo-safety.php --self-test && php tests/run-php-tests.php && php tests/guard.test.php && bash tests/lint-php.test.sh",
    "test:audit": "bash tests/audit-harness.test.sh",
    "test:all": "npm test && npm run test:php && npm run test:audit",
    "lint:php": "bash tools/lint-php.sh tools examples projects tests",
    "audit": "bash tools/audit-harness.sh",
    "validate:schema": "node tools/schema-graph-validator.js",
    "verify:safety": "php tools/verify-seo-safety.php"
  },
  "keywords": [
    "wordpress",
    "seo",
    "technical-seo",
    "harness-engineering",
    "ai-agents",
    "claude-code",
    "codex",
    "antigravity",
    "schema-org",
    "core-web-vitals",
    "genisoft"
  ],
  "author": "Abdelmonem Lefi (Genisoft)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lefi0528/genisoft-wp-seo-harness.git"
  },
  "devDependencies": {
    "vitepress": "^1.6.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
